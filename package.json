{
  "name": "agentic-markdown",
  "version": "0.0.5",
  "private": false,
  "description": "A tiny Markdown-first template engine for variables and conditional content.",
  "keywords": [
    "agent",
    "markdown",
    "template",
    "template-engine",
    "conditional-comments",
    "agentic",
    "codex",
    "claude"
  ],
  "license": "MIT",
  "author": "CRIMX <straybugs@gmail.com> (https://github.com/crimx/)",
  "repository": "crimx/agentic-markdown",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:ci": "biome ci",
    "ts-check": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json && biome format --write --config-path=biome.docs.json --files-ignore-unknown=true docs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "build": "tsdown",
    "build:min": "MINIFY=true tsdown && echo '' && gzip-size dist/index.mjs dist/index.cjs",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@wopjs/gzip-size": "^0.1.5",
    "commit-and-tag-version": "^13.1.2",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  }
}
